# OPENROUTER_API_KEY: Key for OpenRouter / Gemini API calls
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_API_KEY"

# OPENROUTER_API_MODEL: AI model to use
OPENROUTER_API_MODEL="google/gemini-2.5-flash-lite"

# DATABASE_URL: PostgreSQL Database connection string for production persistence
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# JWT_SECRET: Secret key used to sign and verify authentication JWTs
JWT_SECRET="REPLACE_WITH_A_SECURE_64_CHARACTER_RANDOM_STRING"

# APP_URL: Base URL of the application
APP_URL="http://localhost:7869"
